# Required: Claude API key used to draft contracts.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Required: where contracts are stored (Supabase Postgres).
# Create a free project at https://supabase.com, then:
#   - SUPABASE_URL: Project Settings -> Data API -> Project URL
#   - SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API Keys -> service_role
#     (NOT the anon/publishable key - this one bypasses Row Level Security,
#     so keep it server-side only and never expose it to the browser)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Required to actually email signing links and the final signed contract.
# Get one at https://resend.com/api-keys (free tier available)
RESEND_API_KEY=re_...

# The "from" address emails are sent as. Until you verify your own domain
# with Resend, you can leave this as the shared sandbox sender below -
# it works for testing but looks less trustworthy to recipients.
EMAIL_FROM="DealSeal <onboarding@resend.dev>"

# Public URL this app is deployed at (no trailing slash). Used to build the
# signing links that get emailed out. For local dev, the default below is fine.
NEXT_PUBLIC_APP_URL=http://localhost:3000
